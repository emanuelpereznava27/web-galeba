# ─────────────────────────────────────────────────────────────
#  Logistics Galeba — Variables de entorno
#  Copia este archivo a `.env.local` y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Proveedor de correo del formulario: resend | smtp | log
# "log" (por defecto) sólo imprime el mensaje en consola — ideal para demo.
EMAIL_PROVIDER=log

# ── Resend (recomendado en Vercel) ──
RESEND_API_KEY=

# ── SMTP (correo de Galeba en Google Workspace) ──
# SOLO necesitas SMTP_PASS: la contraseña de aplicación de Google (16 letras).
# Los demás valores ya traen por defecto Gmail:
#   SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_SECURE=true
#   SMTP_USER=gerencia@galeba.com · EMAIL_PROVIDER=smtp (automático si hay SMTP_PASS)
# (Contraseña de aplicación: myaccount.google.com → Seguridad →
#  Verificación en 2 pasos → Contraseñas de aplicaciones.)
SMTP_PASS=

# ── Remitente y destinatario ──
# OJO: mientras galeba.com.mx NO esté verificado en Resend, el remitente (MAIL_FROM)
# debe ser el de prueba: "Sitio Web Galeba <onboarding@resend.dev>".
# Si no defines MAIL_FROM, el código ya usa ese por defecto con Resend (déjalo vacío).
# Cuando verifiques galeba.com.mx en Resend, podrás usar p. ej.:
#   MAIL_FROM="Sitio Web Galeba <web@galeba.com.mx>"
MAIL_FROM="Sitio Web Galeba <onboarding@resend.dev>"
# Las cotizaciones del formulario llegan a gerencia:
MAIL_TO_GERENCIA=gerencia@galeba.com
# (Opcional) Copia a operaciones; déjalo vacío para enviar solo a gerencia.
MAIL_TO_OPERACIONES=

# ── Analítica (opcional) ──
NEXT_PUBLIC_GA_ID=

# ── URL pública del sitio (sitemap, Open Graph, JSON-LD) ──
NEXT_PUBLIC_SITE_URL=https://galeba.com.mx
